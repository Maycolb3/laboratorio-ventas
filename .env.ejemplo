# Copiar este archivo como .env en CADA computador y ajustar los valores.
# Las IP son las de Tailscale (comando: tailscale ip -4). Los tres equipos
# deben estar en la misma red de Tailscale y verse entre sí.

# Letra de este computador: A, B o C
NODO=A

# IP de este computador y de los otros dos (el orden de los otros da igual)
MI_IP=100.99.60.63
IP_OTRO_1=100.76.106.78
IP_OTRO_2=100.94.112.43

# Enlaces públicos de la interfaz en los tres computadores (tailscale funnel),
# separados por coma. La página los usa para seguir funcionando si cae el suyo.
ENTRADAS=https://computador-a.tailXXXX.ts.net,https://computador-b.tailXXXX.ts.net,https://computador-c.tailXXXX.ts.net
