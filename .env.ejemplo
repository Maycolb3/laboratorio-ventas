# Copiar este archivo como .env en CADA computador y ajustar los valores.
# Las IP son las de Tailscale (comando: tailscale ip -4). Todos los equipos
# deben estar en la misma red de Tailscale y verse entre sí.

# Letra de este computador: A, B o C (Windows), D (VM con Kali Linux) o E (Mac)
NODO=A

# IP de este computador
MI_IP=100.99.60.63

# IP de TODOS los computadores, separadas por coma (este incluido). Es la
# misma línea en los cinco .env. Todos votan en la base de datos: con cinco,
# el sistema sigue funcionando mientras haya 3 de 5 encendidos.
# Reemplazar IP_DE_D e IP_DE_E por las IP de la VM de Kali y del Mac.
NODOS=100.99.60.63,100.76.106.78,100.94.112.43,IP_DE_D,IP_DE_E

# Enlaces públicos de la interfaz, separados por coma. La página los usa para
# seguir funcionando si cae el suyo.
#  - Con Cloudflare Tunnel (un solo enlace para todo el sistema): solo ese enlace.
#  - Con Tailscale Funnel (un enlace por computador): todos los enlaces.
ENTRADAS=https://ventas.sistemasdistribuidos.me

# Token del túnel de Cloudflare (README, paso 11). El MISMO en todos los
# computadores; pedirlo por un chat privado. Sin token, no hay enlace público.
TUNNEL_TOKEN=pegar-aqui-el-token-del-tunel
